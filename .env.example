# All optional. The app runs with none of these set (demo auth + local user file + simulated checkout).
AUTH_SECRET=change-me-to-a-long-random-string
# Stripe TEST mode only (keys must start with sk_test_)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Optional persistent user store for deployments (Upstash Redis / Vercel KV REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: public base URL used for Stripe redirect URLs
APP_URL=
